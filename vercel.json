{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/despre", "destination": "/storyteller", "permanent": true },
    { "source": "/founder", "destination": "/storyteller", "permanent": true },
    { "source": "/servicii", "destination": "/studio", "permanent": true },
    { "source": "/film", "destination": "/studio", "permanent": true },
    { "source": "/portofoliu", "destination": "/studio", "permanent": true },
    { "source": "/produse", "destination": "/shop", "permanent": true },
    { "source": "/curs", "destination": "/shop", "permanent": true },
    { "source": "/blog", "destination": "/journal", "permanent": true },
    { "source": "/travel", "destination": "/journeys", "permanent": true },
    { "source": "/en", "destination": "/", "permanent": true },
    { "source": "/en/about", "destination": "/storyteller", "permanent": true },
    { "source": "/en/services", "destination": "/studio", "permanent": true },
    { "source": "/en/film", "destination": "/studio", "permanent": true },
    { "source": "/en/contact", "destination": "/contact", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
